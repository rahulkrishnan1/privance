{
  "name": "@privance/web",
  "version": "0.0.0-dev",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sim-worker.mjs && vite --port 8081",
    "build:sim-worker": "node scripts/build-sim-worker.mjs",
