# Copy to /etc/privance/env.d/caddy.env on the host (mode 600). No secrets in this template.

# --- Caddy terminates TLS (default) ------------------------------------------

# Primary domain for the instance (without www prefix).
DOMAIN=<your-domain>

# Optional alias. Set to the same value as DOMAIN if no alias is needed.
WWW_DOMAIN=www.<your-domain>

# Email address for ACME account registration.
# Required even when Caddy does not manage certificates: the directive has no default.
ACME_EMAIL=<operator-email>

# Empty when Caddy terminates TLS itself.
LOCAL_HTTP_ONLY=

# --- TLS terminates upstream (reverse proxy, private network) ----------------
# See "Reverse proxy or private network" in infra/README.md.
#
# DOMAIN=http://<host>
# WWW_DOMAIN=http://<host>
# LOCAL_HTTP_ONLY=auto_https off
